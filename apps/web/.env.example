# Neon Database Configuration
# Get this from your Neon dashboard: https://console.neon.tech/
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Authentication Secret (generate a secure random string)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secure-random-string-here

# CORS Configuration (add your production domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://your-domain.vercel.app

# Create Integration Configuration (update with your production URL)
NEXT_PUBLIC_CREATE_BASE_URL=https://your-domain.vercel.app
NEXT_PUBLIC_CREATE_HOST=your-domain.vercel.app
NEXT_PUBLIC_PROJECT_GROUP_ID=nas2-project

# Node Environment
NODE_ENV=production